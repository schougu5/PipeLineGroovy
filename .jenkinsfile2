pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                bat "mvn clean"
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying the code'
            }
        }

        stage('Test') {
            steps {
                bat "mvn test"
            }
        }

        stage('Unit Testing') {
            steps {
                bat "mvn compile"
            }
        }

        stage('Release') {
            when {
                branch 'main'  // ✅ 'origin/' is not needed here — just 'main'
            }
            steps {
                echo 'Releasing the project'
            }
        }
    }
}
